{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CochraneK/AI-persona/ontology/persona_kernel.schema.json",
  "title": "Human Ontology v2 Persona Kernel",
  "type": "object",
  "required": [
    "persona_id",
    "ontology_version",
    "domains",
    "field_metadata",
    "relations",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "persona_id": {
      "type": "string",
      "minLength": 1
    },
    "ontology_version": {
      "const": "2.0.0"
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "development": {
          "type": "object"
        },
        "body_functioning_health": {
          "type": "object"
        },
        "mental_neurodevelopmental_health": {
          "type": "object"
        },
        "personality_psychology": {
          "type": "object"
        },
        "abilities_skills_interests": {
          "type": "object"
        },
        "identity_self_concept": {
          "type": "object"
        },
        "roles": {
          "type": "object"
        },
        "relationships": {
          "type": "object"
        },
        "place_mobility": {
          "type": "object"
        },
        "education_learning": {
          "type": "object"
        },
        "work_economic_participation": {
          "type": "object"
        },
        "social_institutional_position": {
          "type": "object"
        },
        "culture_language": {
          "type": "object"
        },
        "life_events": {
          "type": "object"
        },
        "context_ecology": {
          "type": "object"
        },
        "resources_constraints_opportunities": {
          "type": "object"
        },
        "lifestyle_routines": {
          "type": "object"
        },
        "current_state": {
          "type": "object"
        }
      }
    },
    "field_metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fieldMetadata"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationRecord"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventRecord"
      }
    }
  },
  "$defs": {
    "fieldMetadata": {
      "type": "object",
      "required": [
        "source_type",
        "confidence",
        "provenance",
        "temporal_class"
      ],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "enum": [
            "user_provided",
            "observed",
            "measured",
            "inferred",
            "generated",
            "derived",
            "external_reference",
            "input_constraint"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "temporal_class": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "enum": [
                  "inferred",
                  "generated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number"
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "temporal_class": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "input_constraint"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "temporal_class": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "relationRecord": {
      "type": "object",
      "required": [
        "relation_id",
        "canonical_path",
        "predicate",
        "subject",
        "object",
        "source_type",
        "provenance",
        "temporal_class"
      ],
      "properties": {
        "predicate": {
          "enum": [
            "has_role",
            "related_to_person",
            "located_in",
            "born_in",
            "grew_up_in",
            "lived_in",
            "participates_in_culture",
            "uses_language",
            "member_of",
            "works_for",
            "studies_at",
            "holds_credential",
            "has_resource",
            "faces_constraint",
            "has_opportunity",
            "experienced_event",
            "has_health_condition",
            "has_symptom_or_experience",
            "receives_support",
            "has_trigger",
            "resides_in",
            "situated_in_context"
          ]
        },
        "source_type": {
          "enum": [
            "user_provided",
            "observed",
            "measured",
            "inferred",
            "generated",
            "derived",
            "external_reference",
            "input_constraint"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "temporal_class": {
          "type": "string",
          "minLength": 1
        },
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_path": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$"
        },
        "subject": {
          "$ref": "#/$defs/entityRef"
        },
        "object": {
          "$ref": "#/$defs/entityRef"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "enum": [
                  "inferred",
                  "generated"
                ]
              }
            }
          },
          "then": {
            "required": [
              "confidence",
              "provenance",
              "temporal_class"
            ],
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "temporal_class": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "input_constraint"
              }
            }
          },
          "then": {
            "required": [
              "provenance",
              "temporal_class"
            ],
            "properties": {
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "temporal_class": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "has_role"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "role"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "related_to_person"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "person"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "located_in"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "place"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "born_in"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "place"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "grew_up_in"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "place"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "lived_in"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "place"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "participates_in_culture"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "culture_context"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "uses_language"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "language"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "member_of"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "organization"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "works_for"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "organization"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "studies_at"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "organization"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "holds_credential"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "credential"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "has_resource"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "resource"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "faces_constraint"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "constraint"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "has_opportunity"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "opportunity"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "experienced_event"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "event"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "has_health_condition"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "health_condition"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "has_symptom_or_experience"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "generic"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "receives_support"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "person",
                      "organization",
                      "resource"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "has_trigger"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "generic",
                      "event"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "resides_in"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "place"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "situated_in_context"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "entity_type": {
                    "const": "person"
                  }
                }
              },
              "object": {
                "properties": {
                  "entity_type": {
                    "enum": [
                      "place",
                      "organization",
                      "generic"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "eventRecord": {
      "type": "object",
      "required": [
        "event_id",
        "canonical_path",
        "type",
        "source_type",
        "provenance",
        "temporal_class"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "user_provided",
            "observed",
            "measured",
            "inferred",
            "generated",
            "derived",
            "external_reference",
            "input_constraint"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "temporal_class": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_path": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityRef"
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "enum": [
                  "inferred",
                  "generated"
                ]
              }
            }
          },
          "then": {
            "required": [
              "confidence",
              "provenance",
              "temporal_class"
            ],
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "temporal_class": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "input_constraint"
              }
            }
          },
          "then": {
            "required": [
              "provenance",
              "temporal_class"
            ],
            "properties": {
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "temporal_class": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "entityRef": {
      "type": "object",
      "required": [
        "entity_id",
        "entity_type"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "person",
            "role",
            "place",
            "organization",
            "language",
            "culture_context",
            "health_condition",
            "credential",
            "resource",
            "constraint",
            "opportunity",
            "event",
            "generic"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
