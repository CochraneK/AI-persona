{
  "name": "BFI-44 大五人格量表",
  "description": "Big Five Inventory — 44 题五级里克特量表，测量五大核心人格特质",
  "instruction": "请你以第一人称视角，根据自身感受回答以下问题。回答没有对错之分，请诚实选择。对于每个描述，选择你认同的程度：1=非常不同意，2=不太同意，3=不确定，4=比较同意，5=非常同意。",
  "scale": {
    "1": "非常不同意",
    "2": "不太同意",
    "3": "不确定",
    "4": "比较同意",
    "5": "非常同意"
  },
  "traits": {
    "EXT": "外向性 (Extraversion) — 活跃、健谈、社交导向的程度",
    "AGR": "宜人性 (Agreeableness) — 合作、信任、利他倾向的程度",
    "CON": "尽责性 (Conscientiousness) — 有条理、可靠、自律的程度",
    "NEU": "神经质 (Neuroticism) — 情绪不稳定、易焦虑、敏感的程度",
    "OPN": "开放性 (Openness) — 好奇、创造、接受新事物的程度"
  },
  "items": [
    {"id": 1,  "text": "我觉得自己是一个健谈的人",                                            "trait": "EXT", "direction": "+"},
    {"id": 2,  "text": "我倾向于挑剔别人的毛病",                                            "trait": "AGR", "direction": "-"},
    {"id": 3,  "text": "我会把工作做得很彻底、很彻底",                                      "trait": "CON", "direction": "+"},
    {"id": 4,  "text": "我觉得自己很沮丧、情绪低落",                                        "trait": "NEU", "direction": "+"},
    {"id": 5,  "text": "我会有新想法、有创意",                                              "trait": "OPN", "direction": "+"},
    {"id": 6,  "text": "我是一个缄默、内敛的人",                                            "trait": "EXT", "direction": "-"},
    {"id": 7,  "text": "我是一个乐于助人、不自私的人",                                      "trait": "AGR", "direction": "+"},
    {"id": 8,  "text": "我有时候会有点粗心",                                                "trait": "CON", "direction": "-"},
    {"id": 9,  "text": "我能很好地应对压力，比较放松",                                      "trait": "NEU", "direction": "-"},
    {"id": 10, "text": "我对很多不同的事情都充满好奇",                                      "trait": "OPN", "direction": "+"},
    {"id": 11, "text": "我精力充沛",                                                        "trait": "EXT", "direction": "+"},
    {"id": 12, "text": "我喜欢和人争吵、起冲突",                                            "trait": "AGR", "direction": "-"},
    {"id": 13, "text": "我是一个值得信赖的工作者（做事靠谱）",                              "trait": "CON", "direction": "+"},
    {"id": 14, "text": "我容易紧张",                                                        "trait": "NEU", "direction": "+"},
    {"id": 15, "text": "我是一个有深度、善于思考的人",                                      "trait": "OPN", "direction": "+"},
    {"id": 16, "text": "我能激发出很多热情",                                                "trait": "EXT", "direction": "+"},
    {"id": 17, "text": "我倾向于原谅别人",                                                  "trait": "AGR", "direction": "+"},
    {"id": 18, "text": "我做事比较没有条理",                                                "trait": "CON", "direction": "-"},
    {"id": 19, "text": "我经常担心很多事情",                                                "trait": "NEU", "direction": "+"},
    {"id": 20, "text": "我有很活跃的想象力",                                                "trait": "OPN", "direction": "+"},
    {"id": 21, "text": "我倾向于保持安静",                                                  "trait": "EXT", "direction": "-"},
    {"id": 22, "text": "我总体上比较信任他人",                                              "trait": "AGR", "direction": "+"},
    {"id": 23, "text": "我有点懒散",                                                        "trait": "CON", "direction": "-"},
    {"id": 24, "text": "我情绪稳定，不容易烦躁",                                            "trait": "NEU", "direction": "-"},
    {"id": 25, "text": "我善于发明创造",                                                    "trait": "OPN", "direction": "+"},
    {"id": 26, "text": "我有比较强势的性格",                                                "trait": "EXT", "direction": "+"},
    {"id": 27, "text": "我可能有点冷漠、不太合群",                                          "trait": "AGR", "direction": "-"},
    {"id": 28, "text": "我会坚持不懈直到任务完成",                                          "trait": "CON", "direction": "+"},
    {"id": 29, "text": "我情绪容易波动",                                                    "trait": "NEU", "direction": "+"},
    {"id": 30, "text": "我重视艺术和审美体验",                                              "trait": "OPN", "direction": "+"},
    {"id": 31, "text": "我有时会害羞、拘谨",                                                "trait": "EXT", "direction": "-"},
    {"id": 32, "text": "我对几乎每个人都体贴、友善",                                        "trait": "AGR", "direction": "+"},
    {"id": 33, "text": "我做事效率高",                                                      "trait": "CON", "direction": "+"},
    {"id": 34, "text": "在紧张情况下我能保持冷静",                                          "trait": "NEU", "direction": "-"},
    {"id": 35, "text": "我更喜欢做那些常规性、程式化的工作",                                "trait": "OPN", "direction": "-"},
    {"id": 36, "text": "我性格外向，善于社交",                                              "trait": "EXT", "direction": "+"},
    {"id": 37, "text": "我有时会对别人不太礼貌",                                            "trait": "AGR", "direction": "-"},
    {"id": 38, "text": "我会制定计划并坚持执行",                                            "trait": "CON", "direction": "+"},
    {"id": 39, "text": "我很容易紧张不安",                                                  "trait": "NEU", "direction": "+"},
    {"id": 40, "text": "我喜欢思考、琢磨各种想法",                                          "trait": "OPN", "direction": "+"},
    {"id": 41, "text": "我对艺术方面的兴趣不多",                                            "trait": "OPN", "direction": "-"},
    {"id": 42, "text": "我喜欢和别人合作",                                                  "trait": "AGR", "direction": "+"},
    {"id": 43, "text": "我很容易分心",                                                      "trait": "CON", "direction": "-"},
    {"id": 44, "text": "我在艺术、音乐或文学方面有不错的品位",                              "trait": "OPN", "direction": "+"}
  ]
}