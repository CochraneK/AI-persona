{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Ontology Multi-AI Case Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotations",
    "forbidden_inference_checks"
  ],
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_key",
          "canonical_domain",
          "knowledge_status",
          "kind",
          "relation_predicate",
          "source_type",
          "confidence"
        ],
        "properties": {
          "fact_key": {
            "type": "string"
          },
          "canonical_domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "knowledge_status": {
            "enum": [
              "known",
              "unknown",
              "absent",
              "insufficient_information"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "entity",
              "quality_disposition",
              "role",
              "relation",
              "process_event",
              "state",
              null
            ]
          },
          "relation_predicate": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason_short": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "forbidden_inference_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "entailed"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "entailed": {
            "type": "boolean"
          },
          "reason_short": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
